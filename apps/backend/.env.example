NODE_ENV=development
PORT=3000

# Drizzle ORM configuration
# For local MySQL (docker-compose):
DATABASE_URL=mysql://app_user:app_password@127.0.0.1:3307/my_app_db
# For TiDB Cloud Serverless (TLS required). Get the URL from your TiDB Cloud console:
# DATABASE_URL=mysql://<user>:<password>@<host>:4000/<database>?ssl=%7B%22rejectUnauthorized%22%3Atrue%7D

# Better Auth configuration
# A secret key for Better Auth, generate it using `openssl rand -base64 32`
BETTER_AUTH_SECRET=development-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# Frontend origin (Vite default). Used for Express CORS and Better Auth trustedOrigins
FRONTEND_URLS=http://localhost:5173,http://localhost:4173

# Resend API key for sending emails in production.
# Not required in development (Mailpit is used instead).
RESEND_API_KEY=dummy_api_key_for_example

# Sender email address used in the `from` field of outgoing emails.
SMTP_FROM=noreply@localhost
