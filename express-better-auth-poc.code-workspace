{
  "folders": [
    {
      "name": "root",
      "path": ".",
    },
    {
      "name": "backend",
      "path": "./apps/backend",
    },
    {
      "name": "web",
      "path": "./apps/web",
    },
  ],
  "settings": {
    // hide apps directory in the root folder view (use backend/web roots instead)
    "files.exclude": {
      "apps": true,
    },
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "always",
    },
    "[yaml]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[yml]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[dockercompose]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[json]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "cSpell.userWords": ["oxlint", "oxfmt"],
    "cssVariables.lookupFiles": [
      "**/*.css",
      "**/*.scss",
      "**/*.sass",
      "**/*.less",
      "node_modules/@mantine/core/styles.css",
    ],
  },
  "extensions": {
    "recommendations": ["oxc.oxc-vscode", "vunguyentuan.vscode-css-variables"],
  },
}
